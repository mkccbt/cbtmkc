# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing CBT session & CSRF tokens.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# DATABASE_URL: Optional PostgreSQL connection string (e.g. Neon / Supabase via Vercel Storage)
# for permanent data persistence across Vercel serverless instances.
DATABASE_URL=""

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional Firebase Service Account JSON (raw or base64)
# for permanent Firestore persistence on Vercel serverless deployments.
FIREBASE_SERVICE_ACCOUNT_JSON=""
